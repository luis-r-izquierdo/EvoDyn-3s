             Select[{
               ToRules[$CellContext`rest$$]}, Not[
               
               ListQ[#]]& ]], $CellContext`restPoints$$ = {}; \
$CellContext`restRegions$$ = {}; Null]; If[
          
          And[$CellContext`restRegions$$ != {}, $CellContext`restPoints$$ != \
