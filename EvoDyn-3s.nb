Cell[TextData[{
 "EvoDyn-3s is a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook created \nto analyse various evolutionary dynamics in 3-strategy \
games.\nCopyright (C) 2018. ",
 ButtonBox["Luis R. Izquierdo",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://luis.izqui.org"], None},
  ButtonNote->"http://luis.izqui.org"],
 ", ",
