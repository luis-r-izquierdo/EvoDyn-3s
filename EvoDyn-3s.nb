            Part[$CellContext`x, $CellContext`i], {$CellContext`i, \
$CellContext`n}]]; $CellContext`ExpectedChange[
          Pattern[$CellContext`x, 
           Blank[]], 
          Pattern[$CellContext`A, 
           Blank[]], 
          Pattern[$CellContext`\[Alpha], 
           Blank[]], 
          Pattern[$CellContext`parameter, 
           Blank[]], 
          Pattern[$CellContext`m, 
           Blank[]], 
          Pattern[$CellContext`f, 
           Blank[]]] := (
           1 - $CellContext`m) $CellContext`f[$CellContext`x, $CellContext`A, \
$CellContext`\[Alpha], $CellContext`parameter] + $CellContext`m (
           ConstantArray[
            1/3, 3] - $CellContext`x); $CellContext`RobustEigenvalues[
          Pattern[$CellContext`A, 
           Blank[]]] := If[Total[$CellContext`A, 2] === Indeterminate, {
           Style["Indet.", Red], 
           Style["Indet.", Red]}, 
          Eigenvalues[$CellContext`A]]; $CellContext`possibleEvents[
          Pattern[$CellContext`numTypes, 
           Blank[]], 
          Pattern[$CellContext`numDraws, 
           Blank[]]] := Flatten[
          Map[Permutations, 
           IntegerPartitions[$CellContext`numDraws, {$CellContext`numTypes}, 
            Range[0, $CellContext`numDraws]]], 
          1]; $CellContext`possibleEventsWithProbabilities[
          Pattern[$CellContext`numDraws, 
           Blank[]], 
          Pattern[$CellContext`probabilities, 
           Blank[List]]] := 
        Module[{$CellContext`events = $CellContext`possibleEvents[
             Length[$CellContext`probabilities], $CellContext`numDraws]}, 
          
          Map[{#, Apply[Multinomial, #] 
            Apply[Times, $CellContext`probabilities^#]}& , \
$CellContext`events]]; $CellContext`MapAtColumn[
          Pattern[$CellContext`f, 
           Blank[]], 
          Pattern[$CellContext`l, 
           Blank[]], 
          Pattern[$CellContext`c, 
           Blank[]]] := 
        Map[MapAt[$CellContext`f, #, $CellContext`c]& , $CellContext`l]; \
$CellContext`PMF[
          Pattern[$CellContext`l, 
           Blank[]]] := SortBy[
          Map[{
            Part[#, 1, 1], 
            Total[
             Map[Last, #]]}& , 
           GatherBy[$CellContext`l, First]], 
          First]; $CellContext`AccumulateAndFixColumnInMatrix[
          Pattern[$CellContext`c, 
           Blank[]], 
          Pattern[$CellContext`m, 
           Blank[]]] := 
        Module[{$CellContext`new = $CellContext`m}, 
          Part[$CellContext`new, All, $CellContext`c] = Most[
             FoldList[Plus, 0, 
              
              Part[$CellContext`m, 
               All, $CellContext`c]]]; $CellContext`new]; \
$CellContext`TurnListIntoFunctionOf[
          Pattern[$CellContext`l, 
           Blank[]], 
          Pattern[$CellContext`x, 
           Blank[]]] := 
        Module[{$CellContext`m = $CellContext`MapAtColumn[$CellContext`x == #& \
, $CellContext`l, 1]}, 
          Piecewise[
           Map[Reverse, $CellContext`m], 
           0]]; $CellContext`TurnCumulativeListIntoFunctionOf[
          Pattern[$CellContext`l, 
           Blank[]], 
          Pattern[$CellContext`x, 
           Blank[]]] := Module[{$CellContext`m = Prepend[
             $CellContext`MapAtColumn[$CellContext`x <= #& , $CellContext`l, 
              1], {$CellContext`x <= First[
                First[$CellContext`l]], 0}]}, 
          Piecewise[
           Map[Reverse, $CellContext`m], 
           1]]; $CellContext`TurnCumulativeListIntoStrictFunctionOf[
          Pattern[$CellContext`l, 
           Blank[]], 
          Pattern[$CellContext`x, 
           Blank[]]] := Module[{$CellContext`m = Prepend[
             $CellContext`MapAtColumn[$CellContext`x < #& , $CellContext`l, 
              1], {$CellContext`x < First[
                First[$CellContext`l]], 0}]}, 
          Piecewise[
           Map[Reverse, $CellContext`m], 
           1]]; $CellContext`TrialsSupportingFunctions[
          Pattern[$CellContext`x, 
           Blank[List]], 
          Pattern[$CellContext`payoffs, 
           Blank[]], 
          Pattern[$CellContext`trials, 
           Blank[]], 
          Pattern[$CellContext`p, 
           Blank[]], 
          Pattern[$CellContext`\[Alpha], 
           Blank[]]] := 
        Module[{$CellContext`n = 
           Length[$CellContext`payoffs], $CellContext`eventsAndProbs, \
$CellContext`payoffsAndProbabilities, $CellContext`payoffPMFs, \
$CellContext`payoffCDFs, $CellContext`CDFunctions, \
$CellContext`CDStrictFunctions, $CellContext`PDFunctions, $CellContext`pv, \
$CellContext`i}, $CellContext`pv = Table[
             $CellContext`p[$CellContext`i], {$CellContext`i, \
$CellContext`n}]; $CellContext`eventsAndProbs = If[$CellContext`\[Alpha] == 1, 
             Map[{{#, 1}}& , $CellContext`trials IdentityMatrix[3]], 
             
             Map[$CellContext`possibleEventsWithProbabilities[$CellContext`\
trials, #]& , $CellContext`\[Alpha] 
               IdentityMatrix[3] + (1 - $CellContext`\[Alpha]) 
               Table[$CellContext`x, 
                 3]]]; $CellContext`payoffsAndProbabilities = 
           Map[$CellContext`MapAtColumn[
              Function[$CellContext`ev, 
               Dot[$CellContext`payoffs, $CellContext`ev]], #, 
              1]& , $CellContext`eventsAndProbs]; $CellContext`payoffPMFs = 
           Map[$CellContext`PMF[
              Thread[{
                Part[$CellContext`payoffsAndProbabilities, #, All, 1, #], 
                Part[$CellContext`payoffsAndProbabilities, #, All, 2]}]]& , 
             Range[$CellContext`n]]; $CellContext`payoffCDFs = 
           Map[$CellContext`AccumulateAndFixColumnInMatrix[
             2, #]& , $CellContext`payoffPMFs]; $CellContext`CDFunctions = 
           MapThread[$CellContext`TurnCumulativeListIntoStrictFunctionOf, \
{$CellContext`payoffCDFs, $CellContext`pv}]; $CellContext`CDStrictFunctions = 
           MapThread[$CellContext`TurnCumulativeListIntoFunctionOf, \
{$CellContext`payoffCDFs, $CellContext`pv}]; $CellContext`PDFunctions = 
           MapThread[$CellContext`TurnListIntoFunctionOf, \
{$CellContext`payoffPMFs, $CellContext`pv}]; {$CellContext`payoffPMFs, \
$CellContext`CDFunctions, $CellContext`CDStrictFunctions, \
$CellContext`PDFunctions}]; $CellContext`ColorForPairOfEigenvalues[
          Pattern[$CellContext`l, 
           Blank[List]]] := Quiet[
          
          Module[{$CellContext`one, $CellContext`two}, {$CellContext`one, \
$CellContext`two} = $CellContext`l; Piecewise[{{Gray, 
               
               Or[$CellContext`one === Indeterminate, $CellContext`two === 
                Indeterminate]}, {Red, 
               And[
                Reduce[Re[$CellContext`one] < 0], 
                Reduce[Re[$CellContext`two] < 0]]}, {White, 
               Or[
                Reduce[Re[$CellContext`one] > 0], 
                Reduce[Re[$CellContext`two] > 0]]}}, Gray]]]; Null}; 
     Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
 CellLabel->"Out[24]=",ExpressionUUID->"18b3a240-68aa-43eb-88ab-454070258fd1"],

Cell[CellGroupData[{

Cell["Documentation", "Section",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"e5b48c76-9ef9-435c-93ae-347850a12596"],

Cell[TextData[{
 "This notebook shows the phase portrait of various evolutionary dynamics in \
any 3-strategy game. The program also calculates the rest points of the \
dynamic, together with the eigenvalues ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "i"], TraditionalForm]],ExpressionUUID->
  "789ebcbf-b6dd-439c-92ff-2c24bf69d460"],
 " of the Jacobian of the dynamics at the isolated rest points (if the \
Jacobian is defined), which are useful to assess the rest points\
\[CloseCurlyQuote] local stability. \n\nAll computations in EvoDyn-3s are \
conducted using exact arithmetic. Note that, in general, the exact rest \
points and eigenvalues of a dynamic may have long and cumbersome expressions \
(e.g. expressions involving roots of high-order polynomials). Because of \
this, EvoDyn-3s also computes 3-digit numerical approximations to the exact \
quantities, which are shown in the tables below the portrait. The exact \
output can be found in the report produced by EvoDyn-3s, which is created by \
clicking on the \[OpenCurlyDoubleQuote]Generate full report\
\[CloseCurlyDoubleQuote] button. Note that the free Wolfram Player blocks the \
dynamic creation of new files, so EvoDyn-3s has to be run in Mathematica both \
to export the figure and to generate the full report."
}], "Text",ExpressionUUID->"8c845bcb-a751-4dec-8482-ce147cb1ad0b"],

Cell[CellGroupData[{

Cell["Parameters", "Subsection",ExpressionUUID->"590dddd8-31a9-4c5f-b4c8-2bf175fb5cbb"],

Cell[CellGroupData[{

Cell["Payoffs", "Subsubsection",ExpressionUUID->"c076fe37-74af-4c6c-9752-2049e3ce6a44"],

Cell[TextData[{
 "The game is defined by the payoff matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    SubscriptBox["a", "ij"], "]"}], TraditionalForm]],ExpressionUUID->
  "3f53b331-8935-4953-8ba5-eaf0181f118d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "ij"], TraditionalForm]],ExpressionUUID->
  "b39d4a77-9bb4-40af-9831-983ee13d39e3"],
 " represents the payoff obtained by a player using strategy i against a \
player using strategy j. After changing the payoffs, the user should click on \
the button \[OpenCurlyDoubleQuote]update\[CloseCurlyDoubleQuote] to run the \
computations with the new payoffs. The program also contains a set of \
predefined games which can be inspected by clicking on the chooser with the \
label \[OpenCurlyDoubleQuote]Predefined games\[CloseCurlyDoubleQuote]."
}], "Text",ExpressionUUID->"7d6bdaef-365b-4320-ac7c-966c6db12e1c"]
}, Closed]],

Cell[CellGroupData[{

Cell["Assortativity", "Subsubsection",ExpressionUUID->"2eaed39b-5511-4ec6-91fc-673e4fd1cbe8"],

Cell[TextData[{
 "Assortativity affects the way individuals interact to play the game. It is \
the tendency for an agent to preferentially play with individuals who have \
the same strategy. Assortativity in this program is controlled by parameter \
\[Alpha] \[Element] [0,1]. If assortativity \[Alpha] is 0, players interact \
at random, so the probability of meeting a player using strategy i equals the \
frequency of that strategy in the population, i.e. ",
 Cell[BoxData[
  SubscriptBox["x", "i"]],ExpressionUUID->
  "24811c44-f5b9-4d98-bbe9-d122c20cfcbd"],
 ". At the other extreme, if assortativity \[Alpha] is 1, players interact \
only with players using the same strategy as theirs, so a player using \
strategy i will only meet players using strategy i. For intermediate cases, \
\[Alpha] \[Element] (0,1), a player will interact with a random player from \
the population with probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", "-", "\[Alpha]"}], ")"}], TraditionalForm]],ExpressionUUID->
  "c481f51d-ee28-436f-8649-65eaff0058e9"],
 ", and with a player with the same strategy as his with probability \
\[Alpha]. Thus, in particular, assortativity affects the way expected payoffs \
",
 Cell[BoxData[
  SubscriptBox["\[Pi]", "i"]],ExpressionUUID->
  "fd297895-2f2a-4044-adbb-2811d7427817"],
 " are computed, i.e."
}], "Text",ExpressionUUID->"43be6ad7-59cb-434b-aebd-390f8849047f"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["\[Pi]", "i"], "=", 
         RowBox[{
          RowBox[{"\[Alpha]", " ", 
           SubscriptBox["a", "ii"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Alpha]"}], ")"}], " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "1"}], "3"], 
            RowBox[{
             SubscriptBox["a", "ij"], 
             SubscriptBox["x", "j"]}]}]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"e259425d-0476-40d1-9e4a-67a30c0dee4e"]], \
"Text",ExpressionUUID->"04c64329-d55b-403a-ad49-8ba652708c76"]
}, Closed]],

Cell[CellGroupData[{

Cell["Dynamic", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"9e21d07a-5e5e-40f2-a392-7b45d86083ab"],

Cell["The evolutionary dynamics implemented in EvoDyn-3s are:", "Text",ExpressionUUID->"1548dffe-6351-46cd-bf94-80a8ee2eb1a0"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Replicator dynamics",
  FontWeight->"Bold"],
 ": The growth rate of each strategy share is proportional to its prevalence ",
 Cell[BoxData[
  SubscriptBox["x", "i"]],ExpressionUUID->
  "9c93f041-97b2-430e-8a4d-bc91776203c5"],
 " and to the difference ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox["\[Pi]", "i"], "-", "\[Pi]"}], ")"}]],ExpressionUUID->
  "0058c700-f5cd-4e74-8b87-c80bd06fd084"],
 " between the expected payoff to that strategy ",
 Cell[BoxData[
  SubscriptBox["\[Pi]", "i"]],ExpressionUUID->
  "b6e7029c-e6c6-4946-9d44-062971716473"],
 " and the average expected payoff in the population  ",
 Cell[BoxData[
  RowBox[{
   OverscriptBox["\[Pi]", "_"], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "3"], 
    RowBox[{
     SubscriptBox["x", "i"], 
     SubscriptBox["\[Pi]", "i"]}]}]}]],ExpressionUUID->
  "53efbe40-1d76-4299-bcee-f41140682c41"],
 "."
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"f994598c-b819-4bc6-b0f3-d460d328e142"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{" ", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["x", "."], "i"], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["\[Pi]", "i"], "-", 
             OverscriptBox["\[Pi]", "_"]}], ")"}], " ", 
           SubscriptBox["x", "i"]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"df5dcb22-8228-4ebc-92cc-ce8dfdd611dc"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"f5756060-92ec-4e2e-9bb5-3b10d06255b1"],

Cell[TextData[{
 "   There is an error probability \[Epsilon] that each of the players will \
choose the wrong strategy. Specifically, a player with   \n   strategy ",
 StyleBox["i",
  FontSlant->"Italic"],
 " will choose strategy ",
 StyleBox["i",
  FontSlant->"Italic"],
 " with probability (1-\[Epsilon]) and each of the other two strategies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "!=", " ", "i"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfa69c88-7602-4718-8402-8fe77f23949a"],
 " with probability \[Epsilon]/2."
}], "Text",ExpressionUUID->"a0cd08a9-4e04-4d3d-9acc-80050125b706"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Smith dynamics",
  FontWeight->"Bold"],
 ": The flow from strategy j to strategy i is proportional to the prevalence ",
 Cell[BoxData[
  SubscriptBox["x", "j"]],ExpressionUUID->
  "6db03c70-4078-4c4d-a286-a860c478a0cb"],
 " of strategy j and to the expected payoff difference ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox["\[Pi]", "i"], "-", 
    SubscriptBox["\[Pi]", "j"]}], ")"}]],ExpressionUUID->
  "044af486-c33b-47e6-ba87-499c87cc63a0"],
 ", if it is positive."
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10001.},ExpressionUUID->"3211b705-ab90-4f31-95c0-85ad516325a3"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox[
          OverscriptBox["x", "."], "i"], "=", 
         RowBox[{
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{"j", "=", "1"}], "3"], 
           SubscriptBox[
            RowBox[{
             SubscriptBox["x", "j"], "[", 
             RowBox[{
              SubscriptBox["\[Pi]", "i"], "-", 
              SubscriptBox["\[Pi]", "j"]}], "]"}], "+"]}], "-", 
          RowBox[{
           SubscriptBox["x", "i"], " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "1"}], "3"], 
            SubscriptBox[
             RowBox[{"[", 
              RowBox[{
               SubscriptBox["\[Pi]", "j"], "-", 
               SubscriptBox["\[Pi]", "i"]}], "]"}], "+"]}]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"085bf076-3395-463a-aacb-5c3bcf82e14b"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10001.},ExpressionUUID->"665342cc-5bcc-4b95-a952-857847d343d6"],

Cell[TextData[{
 "   where the function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"[", "a", "]"}], "+"], TraditionalForm]],ExpressionUUID->
  "9dba1039-0f97-4cd3-983b-a0b6fc812219"],
 " is such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "a", "]"}], "+"], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"91648244-03be-4a32-a369-90ce8e306a25"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "5b950bcf-6ed9-4480-b1c1-698631922fbe"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"[", "a", "]"}], "+"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"01780520-1928-484f-8348-04e5720c9b87"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[LessEqual]", "0"}], TraditionalForm]],ExpressionUUID->
  "e959ac5b-e382-4111-a019-ea7517a8bd09"],
 "."
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10001.},ExpressionUUID->"5b33a529-729d-4f1b-b157-c1dfcc0f3515"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Brown-von Neumann-Nash dynamics",
  FontWeight->"Bold"],
 ": The flow from strategy j to strategy i is proportional to the prevalence ",
 Cell[BoxData[
  SubscriptBox["x", "j"]],ExpressionUUID->
  "92fb3f6e-0eee-4df4-89b5-3b625419ea1e"],
 " of strategy j and to the expected payoff difference ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox["\[Pi]", "i"], "-", 
    OverscriptBox["\[Pi]", "_"]}], ")"}]],ExpressionUUID->
  "562557bb-7705-4f17-8149-6de6e864b444"],
 ", if it is positive."
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10002.},ExpressionUUID->"9521a366-e960-4b0e-a9c2-58c4a2820b33"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox[
          OverscriptBox["x", "."], "i"], "=", 
         RowBox[{
          SubscriptBox[
           RowBox[{"[", 
            RowBox[{
             SubscriptBox["\[Pi]", "i"], "-", 
             OverscriptBox["\[Pi]", "_"]}], "]"}], "+"], "-", 
          RowBox[{
           SubscriptBox["x", "i"], " ", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "1"}], "3"], 
            SubscriptBox[
             RowBox[{"[", 
              RowBox[{
               SubscriptBox["\[Pi]", "j"], "-", 
               OverscriptBox["\[Pi]", "_"]}], "]"}], "+"]}]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"05e2ac34-dad5-4eb3-af2c-1d37891f4b31"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10002.},ExpressionUUID->"8c08140a-c10b-44c0-95f5-8341a124dc02"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Logit dynamics (parameter: \[Eta])",
  FontWeight->"Bold"],
 ": The flow from strategy j to strategy i is proportional to the prevalence ",
 Cell[BoxData[
  SubscriptBox["x", "j"]],ExpressionUUID->
  "b51c921b-ae97-41b1-bc14-c565b749c847"],
 " of strategy j and to the logit term ",
 Cell[BoxData[
  FractionBox[
   SuperscriptBox["e", 
    RowBox[{
     SubscriptBox["\[Pi]", "i"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"-", "1"}]]}]], 
   RowBox[{
    UnderscriptBox["\[Sum]", "k"], 
    SuperscriptBox["e", 
     RowBox[{
      SubscriptBox["\[Pi]", "k"], " ", 
      SuperscriptBox["\[Eta]", 
       RowBox[{"-", "1"}]]}]]}]]],
  CellChangeTimes->{3.733582832850143*^9},ExpressionUUID->
  "b409da7e-6e69-489c-ab35-eb6a2c84a0bb"],
 ". "
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10003.},ExpressionUUID->"b4bea3cb-ea99-4dd2-817c-314146658899"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{GridBox[{
        {
         RowBox[{
          OverscriptBox[
           SubscriptBox["x", "i"], "."], "=", 
          RowBox[{
           FractionBox[
            SuperscriptBox["e", 
             RowBox[{
              SubscriptBox["\[Pi]", "i"], " ", 
              SuperscriptBox["\[Eta]", 
               RowBox[{"-", "1"}]]}]], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"k", "=", "1"}], "3"], 
             SuperscriptBox["e", 
              RowBox[{
               SubscriptBox["\[Pi]", "k"], " ", 
               SuperscriptBox["\[Eta]", 
                RowBox[{"-", "1"}]]}]]}]], "-", 
           SubscriptBox["x", "i"]}]}]}
       },
       GridBoxAlignment->{"Columns" -> {{"="}}}], " "}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"3213b1f8-d8de-4404-b430-acfdb6ddcb9a"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10003.},ExpressionUUID->"a8dfd50b-95ed-467e-a02a-5b08b67e0771"],

Cell[TextData[{
 "   Parameter \[Eta] modulates the impact of payoff differences on the \
dynamics. As ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "\[Rule]", "0"}], TraditionalForm]],ExpressionUUID->
  "7b36ea3b-4e9b-4b19-a9f1-8aea2654fd06"],
 ", the impact of payoff differences gets more acute and the Logit dynamics \
approach the best response dynamics."
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10003.},ExpressionUUID->"f9312466-dfc3-47ba-a64e-1c3aabecf50f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Single-match imitative logit dynamics (parameter: \[Eta])",
  FontWeight->"Bold"],
 ": This is the mean dynamics of an imitation process in which players obtain \
a payoff in an assortatively weighted random match with another player and \
occasionally revise their strategy. Note that the probability that an agent \
using strategy i plays with an agent using strategy j (obtaining payoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "ij"], TraditionalForm]],ExpressionUUID->
  "248b72ed-e27e-421e-ba7d-f3a61e60c6fd"],
 ") is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "ij"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Alpha]"}], ")"}], 
     SubscriptBox["x", "j"]}]}], TraditionalForm]],ExpressionUUID->
  "ba7a73bd-9a00-43f4-98a0-fa3dd51776a1"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]],ExpressionUUID->
  "b6a6558c-91d6-4b79-9005-946f4b15df00"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "ii"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Alpha]"}], ")"}], 
      SubscriptBox["x", "i"]}], "+", "\[Alpha]"}]}], TraditionalForm]],
  ExpressionUUID->"eb370d44-846d-4deb-ae5a-f03d2de5a17a"],
 ". A revising agent looks at another randomly chosen player (and his \
obtained payoff) and chooses a strategy with probability proportional to the \
logit factors of the two obtained payoffs."
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10004.},ExpressionUUID->"8b08828d-87da-4513-8cc8-0759272bb2ea"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         OverscriptBox[
          SubscriptBox["x", "i"], "."], "=", 
         RowBox[{
          SubscriptBox["x", "i"], " ", 
          RowBox[{
           UnderoverscriptBox["\[Sum]", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "\[NotEqual]", "i"}]}], "3"], 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"k", "=", "1"}], "3"], 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{"m", "=", "1"}], "3"], 
             RowBox[{
              SubscriptBox["x", "j"], " ", 
              SubscriptBox["p", "ik"], " ", 
              SubscriptBox["p", "jm"], 
              FractionBox[
               RowBox[{
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  SubscriptBox["a", "ik"], 
                  SuperscriptBox["\[Eta]", 
                   RowBox[{"-", "1"}]]}]], "-", " ", 
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  SubscriptBox["a", "jm"], 
                  SuperscriptBox["\[Eta]", 
                   RowBox[{"-", "1"}]]}]]}], 
               RowBox[{
                SuperscriptBox["e", 
                 RowBox[{
                  SubscriptBox["a", "ik"], 
                  SuperscriptBox["\[Eta]", 
                   RowBox[{"-", "1"}]]}]], "+", 
                SuperscriptBox["e", 
                 RowBox[{
                  SubscriptBox["a", "jm"], 
                  SuperscriptBox["\[Eta]", 
                   RowBox[{"-", "1"}]]}]]}]]}]}]}]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"5ece969b-e074-41d7-9b10-b551949d08c9"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10004.},ExpressionUUID->"996bbe4e-a3ab-4d39-af15-f02b408a9ddd"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Imitate if better dynamics (parameters: ",
  FontWeight->"Bold"],
 StyleBox["trials",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" and ",
  FontWeight->"Bold"],
 StyleBox["tie breaker",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[")",
  FontWeight->"Bold"],
 ": This is the mean dynamics of an imitation process in which players obtain \
a payoff by playing their strategy a fixed number of times (determined by \
parameter ",
 StyleBox["trials",
  FontSlant->"Italic"],
 ") in assortatively weighted random matches, and occasionally revise their \
strategy. A revising agent looks at another randomly chosen player (who has \
also played his strategy ",
 StyleBox["trials",
  FontSlant->"Italic"],
 " times). If the payoff obtained by the other agent is higher, the strategy \
of the other agent is adopted. In case of tie, if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = min, the strategy with the lowest index is preferred; if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = stick or uniform, the strategy that the revising agent is currently \
using is selected. This last tie breaker is named \
\[OpenCurlyDoubleQuote]stick or uniform\[CloseCurlyDoubleQuote], because the \
mean dynamics are the same if ties are broken uniformly randomly.\
\[LineSeparator]\[LineSeparator]To define the formula of these mean dynamics, \
let ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Pi]", "i", "\[Kappa]"], TraditionalForm]],
  ExpressionUUID->"3f48d653-9f4a-452a-aeec-583a32bd74b0"],
 " be the random variable that corresponds to the payoff that strategy ",
 StyleBox["i",
  FontSlant->"Italic"],
 " obtains in \[Kappa] trials. Let ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalPi]", "i", "\[Kappa]"], TraditionalForm]],
  ExpressionUUID->"101d0c29-8dc7-4b4a-90be-5e14ee4bbbf6"],
 " be the support of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Pi]", "i", "\[Kappa]"], TraditionalForm]],
  ExpressionUUID->"f2984840-4cf9-4748-a540-9f7edad66c8e"],
 ", i.e. the set of different payoffs that strategy ",
 StyleBox["i",
  FontSlant->"Italic"],
 " can obtain in \[Kappa] trials. With this, the imitate if better mean \
dynamics with ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = min reads: "
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10005.},ExpressionUUID->"d01f0cca-9ed0-4e54-87a3-9e70533112b0"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{GridBox[{
            {
             RowBox[{
              OverscriptBox[
               SubscriptBox["x", "i"], "."], "=", 
              RowBox[{"2", 
               SubscriptBox["x", "i"], " ", 
               RowBox[{
                UnderoverscriptBox["\[Sum]", 
                 RowBox[{
                  RowBox[{"j", "=", "1"}], ",", 
                  RowBox[{"j", "\[NotEqual]", "i"}]}], "3"], 
                RowBox[{
                 SubscriptBox["x", "j"], 
                 RowBox[{
                  UnderoverscriptBox["\[Sum]", 
                   RowBox[{"\[Pi]", "\[Element]", 
                    SubsuperscriptBox["\[CapitalPi]", "i", "\[Kappa]"]}], 
                   "3"], " ", 
                  RowBox[{"P", "(", 
                   RowBox[{
                    SubsuperscriptBox["\[Pi]", "i", "\[Kappa]"], "=", 
                    "\[Pi]"}], ")"}]}]}]}]}]}]}
           },
           GridBoxAlignment->{"Columns" -> {{"="}}}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"P", 
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Pi]", "j", "\[Kappa]"], "<", "\[Pi]"}], 
              ")"}]}], "+", 
            RowBox[{"P", 
             RowBox[{"(", 
              RowBox[{
               SubsuperscriptBox["\[Pi]", "j", "\[Kappa]"], "=", "\[Pi]"}], 
              ")"}], 
             SubscriptBox["I", 
              RowBox[{"i", "<", "j"}]]}]}], ")"}]}], "+", 
         SuperscriptBox[
          SubscriptBox["x", "i"], "2"], "-", 
         SubscriptBox["x", "i"]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"83fedfee-9ff6-4f97-a431-d9ebdd7cc431"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10005.},ExpressionUUID->"3327925d-bbbd-4ec0-bba8-2090807490cd"],

Cell[TextData[{
 "   And the imitate if better mean dynamics with ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = stick or uniform reads:"
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10005.},ExpressionUUID->"b5c86340-517e-49ee-8848-6265e0bc148e"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{GridBox[{
         {
          RowBox[{
           OverscriptBox[
            SubscriptBox["x", "i"], "."], "=", 
           RowBox[{
            SubscriptBox["x", "i"], " ", 
            RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{
               RowBox[{"j", "=", "1"}], ",", 
               RowBox[{"j", "\[NotEqual]", "i"}]}], "3"], 
             RowBox[{
              SubscriptBox["x", "j"], 
              RowBox[{
               UnderoverscriptBox["\[Sum]", 
                RowBox[{"\[Pi]", "\[Element]", 
                 SubsuperscriptBox["\[CapitalPi]", "i", "\[Kappa]"]}], "3"], 
               " ", 
               RowBox[{"P", "(", 
                RowBox[{
                 SubsuperscriptBox["\[Pi]", "i", "\[Kappa]"], "=", "\[Pi]"}], 
                ")"}]}]}]}]}]}]}
        },
        GridBoxAlignment->{"Columns" -> {{"="}}}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"P", "(", 
          RowBox[{
           SubsuperscriptBox["\[Pi]", "j", "\[Kappa]"], "\[LessEqual]", 
           "\[Pi]"}], ")"}], "+", 
         RowBox[{"P", "(", 
          RowBox[{
           SubsuperscriptBox["\[Pi]", "j", "\[Kappa]"], "<", "\[Pi]"}], 
          ")"}]}], ")"}]}], "+", 
      SuperscriptBox[
       SubscriptBox["x", "i"], "2"], "-", 
      SubscriptBox["x", "i"]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"400ba12d-a8e5-4923-8cd8-ab0860a51dd1"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10005.},ExpressionUUID->"d4640f8e-a76c-4cc3-a331-00fefb55043c"]
}, Closed]],

Cell[TextData[{
 StyleBox["Sampling best response dynamics (parameters: ",
  FontWeight->"Bold"],
 StyleBox["sample size",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" and ",
  FontWeight->"Bold"],
 StyleBox["tie breaker",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[")",
  FontWeight->"Bold"],
 ": This is the mean dynamics of an adaptive process in which players \
occasionally revise their strategy. A revising agent observes the strategies \
of a number of randomly sampled opponents and then chooses a best response to \
the distribution of strategies in the sample (taking into account \
assortativity \[Alpha]). The number of observations in the sample is \
determined by parameter ",
 StyleBox["sample size",
  FontSlant->"Italic"],
 ", whose default value is 1. (One could think that the revising agent is \
trying to estimate the population state, and he does so by taking a sample of \
individuals of size ",
 StyleBox["sample size",
  FontSlant->"Italic"],
 ".) \[LineSeparator]\[LineSeparator]If there is more than one best response, \
ties are resolved according to a given tie-breaking rule (determined by \
parameter ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 "). If ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = min, the strategy with the lowest index is preferred; if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = unif, a uniformly random choice is conducted among the optimal \
strategies in the test set; if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = stick-min, the strategy that the revising agent is currently using is \
selected if it is among the optimal tested strategies (otherwise, the one \
with the lowest index is selected); finally, if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = stick-unif, the strategy that the revising agent is currently using is \
selected if it is among the optimal tested strategies (otherwise, a uniformly \
random choice is conducted among the optimal strategies in the test set).\
\[LineSeparator]\[LineSeparator]The formula for the differential inclusion \
that results from this revision protocol without considering tie-breakers and \
for assortativity \[Alpha] = 0 can be found in:\[LineSeparator]Oyama, D., \
Sandholm, W. H., and Tercieux, O. (2015). Sampling best response dynamics and \
deterministic equilibrium selection. ",
 StyleBox["Theoretical Economics",
  FontSlant->"Italic"],
 ", 10:243\[Dash]281. ",
 ButtonBox["https://doi.org/10.3982/TE1405",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.3982/TE1405"], None},
  ButtonNote->"https://doi.org/10.3982/TE1405"],
 ".\[LineSeparator]\[LineSeparator]Assortativity affects the computation of \
the expected payoff ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", "i"], TraditionalForm]],ExpressionUUID->
  "6ce5d031-1715-47f0-a377-35e786da92f2"],
 " that a player with strategy ",
 StyleBox["i",
  FontSlant->"Italic"],
 " would obtain in a certain population state ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "3947ac36-b28a-445e-9940-3060f831f3b1"],
 ", as explained above."
}], "Item",ExpressionUUID->"652dedd1-ce12-4253-995e-d33bc89c5358"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Best experienced payoff dynamics (parameters: ",
  FontWeight->"Bold"],
 StyleBox["trials",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", ",
  FontWeight->"Bold"],
 StyleBox["test set rule",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", and ",
  FontWeight->"Bold"],
 StyleBox["tie breaker",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[")",
  FontWeight->"Bold"],
 ": This is the mean dynamics of an adaptive process in which players \
occasionally revise their strategy. A revising agent considers all possible \
strategies (if ",
 StyleBox["test set rule",
  FontSlant->"Italic"],
 " = all) or just another one besides the one he is currently using (if ",
 StyleBox["test set rule",
  FontSlant->"Italic"],
 " = two). These strategies form the test set. Then, the revising agent plays \
each strategy in this test set a fixed number of times (determined by \
parameter ",
 StyleBox["trials",
  FontSlant->"Italic"],
 "), with each play of each strategy being against a newly drawn opponent, \
and chooses the strategy whose total payoff was highest, breaking ties \
according to a given tie-breaking rule (determined by parameter ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 "). If ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = min, the strategy with the lowest index is preferred; if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = unif, a uniformly random choice is conducted among the optimal \
strategies in the test set; if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = stick-min, the strategy that the revising agent is currently using is \
selected if it is among the optimal tested strategies (otherwise, the one \
with the lowest index is selected); finally, if ",
 StyleBox["tie breaker",
  FontSlant->"Italic"],
 " = stick-unif, the strategy that the revising agent is currently using is \
selected if it is among the optimal tested strategies (otherwise, a uniformly \
random choice is conducted among the optimal strategies in the test set). \
\[LineSeparator]\[LineSeparator]The precise formula for assortativity \
\[Alpha] = 0 for various tie-breakers can be found in the following papers:\
\[LineSeparator]Sandholm, W. H., Izquierdo, S. S., and Izquierdo, L. R. \
(2019). Best Experienced Payoff Dynamics and Cooperation in the Centipede \
game. \[LineSeparator]\tTheoretical Economics, vol. 14, no. 4, pp. \
1347\[Dash]1385. https://doi.org/10.3982/TE3565.\[LineSeparator]Sandholm, W. \
H., Izquierdo, S. S., and Izquierdo, L. R. (2020). Stability for Best \
Experienced Payoff Dynamics. \[LineSeparator]\tJournal of Economic Theory, \
vol. 185, 104957. \
https://doi.org/10.1016/j.jet.2019.104957.\[LineSeparator]Izquierdo, S. S., \
and Izquierdo, L. R. (2021). \[OpenCurlyQuote]Test two, choose the better\
\[CloseCurlyQuote] leads to high cooperation in the centipede game. \
\[LineSeparator]\tJournal of Dynamics and Games. \
http://dx.doi.org/10.3934/jdg.2021018.\[LineSeparator]\[LineSeparator]\
Assortativity affects the probabilities with which the revising agent meets \
opponents when testing each strategy, depending on their strategies. For a \
player testing strategy ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", the probability ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "ij"], TraditionalForm]],ExpressionUUID->
  "cef63e65-daa7-4e24-95b7-8af279354fc3"],
 " of interacting with an opponent with strategy ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "57a3ecd1-1726-45ae-b9ae-7707a667fa66"],
 ", is:"
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"87b78335-84cb-4eb0-9667-fc4e5a07d808"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["p", "ij"], "=", 
         RowBox[{
          RowBox[{"\[Alpha]", " ", 
           SubscriptBox["x", "i"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Alpha]"}], ")"}], " ", 
           SubscriptBox["x", "j"]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"4bb5457e-803f-454a-b915-5a2c5a767b29"]], \
"Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"4684f90c-5ff7-4d67-ab63-6bd98a5f4b25"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Probability of random strategy", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"bfaf77e0-e6d2-4970-b577-864e9e9975b4"],

Cell[TextData[{
 "The basic dynamic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["x", "i"], "."], "=", 
    RowBox[{
     SubscriptBox["f", "i"], "(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"], ",", 
      SubscriptBox["x", "3"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a12ed43a-8112-413f-a380-42ea86878076"],
 " can be modified by allowing revising players to choose their new strategy \
at random with a certain probability \[Micro]. Formally, the altered dynamic \
which includes this feature reads as follows: "
}], "Text",ExpressionUUID->"7a73b3c6-6ad5-40f9-b61d-cc385c114f05"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{" ", 
      RowBox[{
       OverscriptBox[
        SubscriptBox["x", "i"], "."], "=", 
       RowBox[{GridBox[{
          {
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Mu]"}], ")"}], " ", 
            RowBox[{
             SubscriptBox["f", "i"], "(", 
             RowBox[{
              SubscriptBox["x", "1"], ",", 
              SubscriptBox["x", "2"], ",", 
              SubscriptBox["x", "3"]}], ")"}]}]}
         },
         GridBoxAlignment->{"Columns" -> {{"="}}}], "+", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{
           FractionBox["1", "3"], "-", 
           SubscriptBox["x", "i"]}], ")"}]}]}]}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"2714c35c-4ed8-4281-8207-ab8caa5ce4d0"]], \
"Text",ExpressionUUID->"dc6836c9-62ff-4dcf-ba8e-ccd844a6dd73"]
}, Closed]],

Cell[CellGroupData[{

Cell["Trajectories", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"bed87209-639e-4e3a-80bb-89dca27c294f"],

Cell[TextData[{
 "Parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "max"], TraditionalForm]],ExpressionUUID->
  "817f5da3-006a-49c1-bd48-717866da2795"],
 " controls the maximum time for which the dynamics are integrated. \
Trajectories are computed for a grid of initial conditions of mesh 1/N, where \
N is controlled with the setter whose possible values are: \
\[OpenCurlyDoubleQuote]many\[CloseCurlyDoubleQuote] (N=16), \
\[OpenCurlyDoubleQuote]some\[CloseCurlyDoubleQuote] (N=8), \
\[OpenCurlyDoubleQuote]few\[CloseCurlyDoubleQuote] (N=4), and \
\[OpenCurlyDoubleQuote]none\[CloseCurlyDoubleQuote] (no trajectories)."
}], "Text",ExpressionUUID->"26f7cd6e-d2ee-40d9-bc15-744401e7e367"]
}, Closed]],

Cell[CellGroupData[{

Cell["Color gradient", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"16532bda-d780-4b6b-a32c-2ddb182260e0"],

Cell["\<\
The user can choose among 52 different color gradients to use for the \
(background) density plot showing the speed of the dynamic.\
\>", "Text",ExpressionUUID->"72322232-5053-4331-bd79-d609f3dfb477"]
}, Closed]],

Cell[CellGroupData[{

Cell["Maximum time allowed for computations", "Subsubsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"0d5fd993-f7ad-4edd-b507-cbcbd8c357f9"],

Cell[TextData[{
 "In some dynamics, solving the system ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     SubscriptBox["x", "i"], "."], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"0030f054-239d-4b76-a09e-c3fdb875787d"],
 " exactly, computing the exact eigenvalues at the exact rest points, or even \
plotting the rest components, may take a long time in some games. Parameter ",
 StyleBox["maxTimeOut",
  FontSlant->"Italic"],
 " controls the maximum time allowed to conduct each of these computations."
}], "Text",ExpressionUUID->"83f03c40-c369-4224-b6df-6877fab23eea"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Output", "Subsection",
 CellGroupingRules->{
  "SectionGrouping", 
   Inherited},ExpressionUUID->"597b3f87-ed10-4d79-b4a4-749e420985f7"],

Cell["\<\
The program shows a figure that includes the phase portrait of the chosen \
dynamics in the 2-dimensional simplex, a table with numerical approximations \
to the isolated rest points and their corresponding eigenvalues (if the \
Jacobian is defined), and another showing the components of rest points (when \
applicable). The displayed figure can be exported in vectorial pdf format by \
clicking on the button \[OpenCurlyDoubleQuote]Export figure\
\[CloseCurlyDoubleQuote]. EvoDyn-3s can also produce a full report in \
Mathematica notebook format (.nb) which, besides the aforementioned figure, \
includes all the exact results. This report is dynamically generated by \
clicking on the button \[OpenCurlyDoubleQuote]Generate full report\
\[CloseCurlyDoubleQuote].

The production of the two files (the .pdf figure and the .nb report) is not \
permitted in the free Wolfram Player. It requires Mathematica.\
\>", "Text",ExpressionUUID->"6b7ccf26-cf8a-48fc-aa7a-33705c52788c"]
