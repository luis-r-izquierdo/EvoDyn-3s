                    Derivative[1][$CellContext`x1$][$CellContext`t$], 
                    Derivative[1][$CellContext`x2$][$CellContext`t$], 
                    Derivative[1][$CellContext`x3$][$CellContext`t$]} == 
                   Evaluate[
                    
                    ReplaceAll[$CellContext`expChange$, {$CellContext`x1$ -> \
$CellContext`x1$[$CellContext`t$], $CellContext`x2$ -> \
$CellContext`x2$[$CellContext`t$], $CellContext`x3$ -> \
$CellContext`x3$[$CellContext`t$]}]], {
                    $CellContext`x1$[0], 
                    $CellContext`x2$[0], 
                    $CellContext`x3$[
