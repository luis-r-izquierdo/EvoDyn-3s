                    Subscript[
                    Style["x", Italic], 2]], $CellContext`x3$ -> Text[
                    Subscript[
                    Style["x", Italic], 3]]}], TableSpacing -> {1, 1}, 
                  TableAlignments -> {Left, Bottom}], BaseStyle -> {12}]}, 
