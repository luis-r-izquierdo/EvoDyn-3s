           (SlotSequence[1]& )[]]; $CellContext`listOfArrows$ = If[
           And[$CellContext`tMax$$ >= 0.1, $CellContext`step$$ <= 1], 
           Flatten[
            Map[Table[{
               Arrowheads[0.03], 
               Arrow[
                Round[{
                  ReplaceAll[#, $CellContext`t$ -> $CellContext`i], 
                  ReplaceAll[#, $CellContext`t$ -> $CellContext`i + 0.1]}, 
