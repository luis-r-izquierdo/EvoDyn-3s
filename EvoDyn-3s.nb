           Column[{
             
             Show[{$CellContext`background$, \
$CellContext`graphWithTrajectories$, 
               Graphics[$CellContext`listOfArrows$], 
               If[$CellContext`restPoints$$ != {}, 
                If[
                Length[$CellContext`restPoints$$] == 
                 Length[$CellContext`exactEigenvalues$$], 
                 Graphics[
                  MapThread[{
                    EdgeForm[Thick], 
                    $CellContext`ColorForPairOfEigenvalues[#], 
                    Disk[
                    $CellContext`Simplex2DCoord[#2], 
                    0.02]}& , {$CellContext`exactEigenvalues$$, 
                    N[
                    
                    ReplaceAll[{$CellContext`x1$, $CellContext`x2$, \
$CellContext`x3$}, $CellContext`restPoints$$]]}]], 
                 Graphics[{
                   EdgeForm[Thick], Gray, 
                   Map[Disk[
                    $CellContext`Simplex2DCoord[#], 0.02]& , 
                    N[
                    
                    ReplaceAll[{$CellContext`x1$, $CellContext`x2$, \
$CellContext`x3$}, $CellContext`restPoints$$]]]}]], 
                (SlotSequence[1]& )[]], 
               If[
                And[$CellContext`restRegions$$ != {}, 
                 Not[$CellContext`allStrategiesEqual$]], 
                TimeConstrained[
                 Map[Plot[
                   ReplaceAll[$CellContext`y$, #], {$CellContext`x$, 0, 1}, 
                   PlotStyle -> Directive[Red, 
                    Thickness[0.01]], PlotPoints -> 200]& , 
                  Flatten[
                   Map[Solve[
                    Reduce[#, $CellContext`y$, Reals], $CellContext`y$, 
                    Reals]& , 
                    ReplaceAll[$CellContext`restRegions$$, {$CellContext`x1$ -> 
                    2 $CellContext`y$/Sqrt[3], $CellContext`x2$ -> 
                    1 - $CellContext`x$ - $CellContext`y$/Sqrt[
                    3], $CellContext`x3$ -> $CellContext`x$ - $CellContext`y$/
                    Sqrt[3]}]]]], $CellContext`maxTimeOut$$, 
                 (SlotSequence[1]& )[]], 
                (SlotSequence[1]& )[]], 
               Graphics[
                Map[Inset[
                  Style[
                   First[#], 18, Bold, FontFamily -> "Palatino"], 
                  Last[#]]& , {{"1", {0.5, 0.93}}, {"2", {-0.06, -0.02}}, {
                  "3", {1 + 0.06, -0.02}}}]]}, 
              PlotRange -> {{-0.1, 1 + 0.1}, {-0.1, Sqrt[3]/2 + 0.1}}, Frame -> 
              False, Axes -> False], 
             If[$CellContext`restPoints$$ != {}, 
              Column[{
                Text[
                 Style[
                 "Isolated rest points \
(\!\(\*StyleBox[\"x\",FontSlant->\"Italic\"]\))" <> If[
                    
                    And[$CellContext`f$$ =!= $CellContext`Smith, \
$CellContext`f$$ =!= $CellContext`BNN, $CellContext`exactEigenvalues$$ =!= \
{}], " and eigenvalues (\!\(\*SubscriptBox[\"\[Lambda]\", \
StyleBox[\"i\",FontSlant->\"Italic\"]]\))", ""], Red, Bold, 12]], 
                Text[
                 Row[{
                   NumberForm[
                    TableForm[
                    Chop[
                    N[
                    
                    ReplaceRepeated[{$CellContext`x1$, $CellContext`x2$, \
$CellContext`x3$}, $CellContext`restPoints$$]]], TableHeadings -> {None, {
                    Style[
                    Subscript[
                    Style["x", Italic], 1], 12], 
                    Style[
                    Subscript[
                    Style["x", Italic], 2], 12], 
                    Style[
                    Subscript[
                    Style["x", Italic], 3], 12]}}, TableSpacing -> {1, 1}, 
                    TableAlignments -> {Left, Bottom}], 3], 
                   If[
                    
                    And[$CellContext`f$$ =!= $CellContext`Smith, \
$CellContext`f$$ =!= $CellContext`BNN, $CellContext`exactEigenvalues$$ =!= \
{}], 
                    NumberForm[
                    TableForm[
                    Chop[
                    N[$CellContext`exactEigenvalues$$, 5]], 
                    TableHeadings -> {None, {
                    Subscript[
                    Style["\[Lambda]", Bold, 12], 1], 
                    Subscript[
                    Style["\[Lambda]", Bold, 12], 2]}}, 
                    TableSpacing -> {1, 1}, 
                    TableAlignments -> {Right, Center}], 3], 
                    (SlotSequence[1]& )[]]}, "   "], BaseStyle -> {12}]}, 
               Alignment -> Center, Spacings -> 1, Frame -> True], 
              (SlotSequence[1]& )[]], 
             If[$CellContext`restRegions$$ != {}, 
