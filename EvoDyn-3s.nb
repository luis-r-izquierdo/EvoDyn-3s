             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "The", " ", "following", " ", "three", " ", "lines", " ", "are", " ",
             "the", " ", "only", " ", "ones", " ", "that", " ", "have", " ", 
            "been", " ", "modified", " ", "to", " ", "account", " ", "for", " ",
             "assortativity"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"eventsAndProbs", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"\[Alpha]", "\[Equal]", "1"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"#", ",", "1"}], "}"}], "}"}], "&"}], ",", 
               RowBox[{"trials", "*", 
                RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"possibleEventsWithProbabilities", "[", 
                 RowBox[{"trials", ",", "#"}], "]"}], "&"}], ",", 
               RowBox[{
                RowBox[{"\[Alpha]", "*", 
                 RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Alpha]"}], ")"}], "*", 
                 RowBox[{"Table", "[", 
                  RowBox[{"x", ",", "3"}], "]"}]}]}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"payoffsAndProbabilities", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MapAtColumn", "[", 
               RowBox[{
                RowBox[{"Function", "[", 
                 RowBox[{"ev", ",", 
                  RowBox[{"payoffs", ".", "ev"}]}], "]"}], ",", "#", ",", 
                "1"}], "]"}], "&"}], ",", "eventsAndProbs"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"payoffPMFs", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"PMF", "[", 
               RowBox[{"Thread", "[", 
                RowBox[{"List", "[", 
                 RowBox[{
                  RowBox[{"payoffsAndProbabilities", "[", 
                   RowBox[{"[", 
                    RowBox[{"#", ",", "All", ",", "1", ",", "#"}], "]"}], 
                   "]"}], ",", 
                  RowBox[{"payoffsAndProbabilities", "[", 
                   RowBox[{"[", 
                    RowBox[{"#", ",", "All", ",", "2"}], "]"}], "]"}]}], 
                 "]"}], "]"}], "]"}], "&"}], ",", 
             RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"payoffCDFs", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AccumulateAndFixColumnInMatrix", "[", 
               RowBox[{"2", ",", "#"}], "]"}], "&"}], ",", "payoffPMFs"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"CDFunctions", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{"TurnCumulativeListIntoStrictFunctionOf", ",", 
             RowBox[{"{", 
              RowBox[{"payoffCDFs", ",", "pv"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"CDStrictFunctions", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{"TurnCumulativeListIntoFunctionOf", ",", 
             RowBox[{"{", 
              RowBox[{"payoffCDFs", ",", "pv"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"PDFunctions", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{"TurnListIntoFunctionOf", ",", 
             RowBox[{"{", 
              RowBox[{"payoffPMFs", ",", "pv"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "payoffPMFs", ",", "CDFunctions", ",", "CDStrictFunctions", ",", 
            "PDFunctions"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "GRAPHICS", " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ColorForPairOfEigenvalues", "[", "l_List", "]"}], ":=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"one", ",", "two"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"one", ",", "two"}], "}"}], "=", "l"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Piecewise", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Gray", ",", 
                 RowBox[{
                  RowBox[{"one", "===", "Indeterminate"}], "||", 
                  RowBox[{"two", "===", "Indeterminate"}]}]}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"Red", ",", " ", 
                 RowBox[{
                  RowBox[{"Reduce", "[", 
                   RowBox[{
                    RowBox[{"Re", "@", "one"}], "<", "0"}], "]"}], "&&", 
                  RowBox[{"Reduce", "[", 
                   RowBox[{
                    RowBox[{"Re", "@", "two"}], "<", "0"}], "]"}]}]}], "}"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"White", ",", 
                 RowBox[{
                  RowBox[{"Reduce", "[", 
                   RowBox[{
                    RowBox[{"Re", "@", "one"}], ">", "0"}], "]"}], "||", 
                  RowBox[{"Reduce", "[", 
                   RowBox[{
                    RowBox[{"Re", "@", "two"}], ">", "0"}], "]"}]}]}], 
                "}"}]}], "\[IndentingNewLine]", "}"}], ",", "Gray"}], 
            "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], ";"}], 
     "\[IndentingNewLine]", ")"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"ebe497d7-c6bb-4946-9a6d-3dd577d63d4d"]
}, Closed]]
},
