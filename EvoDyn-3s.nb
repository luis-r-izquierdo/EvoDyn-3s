           Exclusions -> None, PerformanceGoal -> 
           "Quality"]; $CellContext`rest$$ = TimeConstrained[
           
           Reduce[{$CellContext`expChange$ == 0, 0 <= $CellContext`x1$ <= 1, 
             0 <= $CellContext`x2$ <= 1, 0 <= $CellContext`x3$ <= 
             1, $CellContext`x1$ + $CellContext`x2$ + $CellContext`x3$ == 
