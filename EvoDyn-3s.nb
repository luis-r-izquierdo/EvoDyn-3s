             Pattern[$CellContext`component$, 
              Blank[]]] := 
           Module[{$CellContext`closedComponent$ = 
              ReplaceAll[$CellContext`component$, \
$CellContext`closureRule$]}, $CellContext`newRest$ = Or[$CellContext`newRest$, 
               If[
                TrueQ[
                 Reduce[
                  Equivalent[
                   
                   Or[$CellContext`closedComponent$, $CellContext`rest$$], \
