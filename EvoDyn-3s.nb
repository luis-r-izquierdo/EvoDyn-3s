Cell["Source code", "Section",ExpressionUUID->"d7fc9b4c-924e-445b-8538-aebcffdbf017"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", "=", 
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a11", ",", "a12", ",", "a13"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"a21", ",", "a22", ",", "a23"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"a31", ",", "a32", ",", "a33"}], "}"}]}], "}"}], ",", 
          "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
       "listOfProjectedTrajectories", ",", "listOfArrows", ",", 
       "graphWithTrajectories", ",", "background", ",", "allStrategiesEqual", 
       ",", "t", ",", "x", ",", "y", ",", "x1", ",", "x2", ",", "x3", ",", 
       "parameter", ",", "expChange", ",", "jacobian", ",", 
       RowBox[{"closureRule", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Less", "->", "LessEqual"}], ",", 
          RowBox[{"Greater", "->", "GreaterEqual"}]}], "}"}]}], ",", 
       RowBox[{"newRest", "=", "False"}], ",", "points"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"exactEigenvalues", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Choose", " ", "the", " ", "right", " ", "parameter"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"parameter", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "fInterface", ",", "\[IndentingNewLine]", "Replicator", ",", "error", 
         ",", "\[IndentingNewLine]", "Logit", ",", "\[Eta]", ",", 
         "\[IndentingNewLine]", "SingleMatchImitativeLogit", ",", "\[Eta]", ",",
          "\[IndentingNewLine]", "SamplingBestResponse", ",", "SBRsampleSize",
          " ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "sample", " ", "size", " ", "in", " ", "Sampling", " ", "Best", " ",
            "Response", " ", "dynamics"}], " ", "*)"}], ",", 
         "\[IndentingNewLine]", "ImitateIfBetter", ",", "trialsIIB", 
         RowBox[{"(*", " ", 
          RowBox[{
          "number", " ", "of", " ", "trials", " ", "in", " ", 
           "ImitateIfBetter", " ", "dynamics"}], " ", "*)"}], ",", 
         "\[IndentingNewLine]", "_", ",", "trialsBEP"}], "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "number", " ", "of", " ", "trials", " ", "in", " ", "BEP", " ", 
          "dynamics"}], " ", "*)"}], "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Decide", " ", "the", " ", "dynamics"}], " ", "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"f", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "fInterface", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "SamplingBestResponse", ",", 
         RowBox[{"Switch", "[", 
          RowBox[{
          "tieBreakingRuleSBR", ",", "\[IndentingNewLine]", "\"\<min\>\"", ",",
            "SBRMin", ",", "\[IndentingNewLine]", "\"\<unif\>\"", ",", 
           "SBRUnif", ",", "\[IndentingNewLine]", "\"\<stick-min\>\"", ",", 
           "SBRStickMin", ",", "\[IndentingNewLine]", "\"\<stick-unif\>\"", ",",
            "SBRStickUnif"}], "\[IndentingNewLine]", "]"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", "ImitateIfBetter", ",", 
         RowBox[{"Switch", "[", 
          RowBox[{
          "tieBreakingRuleIIB", ",", "\[IndentingNewLine]", "\"\<min\>\"", ",",
            "ImitateIfBetterMin", ",", 
           "\[IndentingNewLine]", "\"\<stick or uniform\>\"", ",", 
           "ImitateIfBetterStickOrUniform"}], "\[IndentingNewLine]", "]"}], ",",
          "\[IndentingNewLine]", "\[IndentingNewLine]", "BEP", ",", 
         RowBox[{"Switch", "[", 
          RowBox[{
          "testSetRule", ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", "\"\<all\>\"", ",", 
           RowBox[{"Switch", "[", 
            RowBox[{
            "tieBreakingRuleBEP", ",", "\[IndentingNewLine]", "\"\<min\>\"", ",",
              "BEPAllMin", ",", "\[IndentingNewLine]", "\"\<unif\>\"", ",", 
             "BEPAllUnif", ",", "\[IndentingNewLine]", "\"\<stick-min\>\"", ",",
              "BEPAllStickMin", ",", 
             "\[IndentingNewLine]", "\"\<stick-unif\>\"", ",", 
             "BEPAllStickUnif"}], "\[IndentingNewLine]", "]"}], ",", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<two\>\"", ",", 
           RowBox[{"Switch", "[", 
            RowBox[{
            "tieBreakingRuleBEP", ",", "\[IndentingNewLine]", "\"\<min\>\"", ",",
              "BEPTwoMin", ",", "\[IndentingNewLine]", "\"\<unif\>\"", ",", 
             "BEPTwoUnif", ",", "\[IndentingNewLine]", "\"\<stick-min\>\"", ",",
              "BEPTwoStick", ",", "\[IndentingNewLine]", "\"\<stick-unif\>\"",
              ",", "BEPTwoStick"}], " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "BEPTwoStickMin", " ", "and", " ", "BEPTwoStickUnif", " ", "are",
               " ", "the", " ", "same"}], " ", "*)"}], "\[IndentingNewLine]", 
            "]"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]",
          "\[IndentingNewLine]", "_", ",", "fInterface"}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "We", " ", "rationalize", " ", "everything", " ", "to", " ", "conduct",
         " ", "operations", " ", "exactly"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"expChange", "=", 
       RowBox[{"ExpectedChange", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], ",", "A", ",", 
         RowBox[{"Rationalize", "[", "a", "]"}], ",", 
         RowBox[{"Rationalize", "[", "parameter", "]"}], ",", 
         RowBox[{"Rationalize", "[", "\[Mu]", "]"}], ",", "f"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", "update", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "This", " ", "is", " ", "a", " ", "trick", " ", "to", " ", "make", " ",
         "the", " ", "\"\<update\>\"", " ", "button", " ", "work"}], " ", 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"allStrategiesEqual", "=", 
       RowBox[{"And", "[", 
        RowBox[{
         RowBox[{"a11", "\[Equal]", "a21", "==", "a31"}], ",", 
         RowBox[{"a12", "==", "a22", "==", "a32"}], ",", 
         RowBox[{"a13", "==", "a23", "==", "a33"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "It", " ", "helps", " ", "to", " ", "deal", " ", "with", " ", "this", " ",
         "degenerate", " ", "case", " ", "separately"}], " ", "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"listOfProjectedTrajectories", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tMax", ">", "0"}], "&&", 
          RowBox[{"step", "\[LessEqual]", "1"}]}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Simplex2DCoord", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "t", "]"}], "&"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"First", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "/.", 
                  RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x1", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"x2", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"x3", "'"}], "[", "t", "]"}]}], "}"}], "\[Equal]", 
                    RowBox[{"Evaluate", "[", 
                    RowBox[{"expChange", "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x1", "\[Rule]", 
                    RowBox[{"x1", "[", "t", "]"}]}], ",", 
                    RowBox[{"x2", "\[Rule]", 
                    RowBox[{"x2", "[", "t", "]"}]}], ",", 
                    RowBox[{"x3", "\[Rule]", 
                    RowBox[{"x3", "[", "t", "]"}]}]}], "}"}]}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x1", "[", "0", "]"}], ",", 
                    RowBox[{"x2", "[", "0", "]"}], ",", 
                    RowBox[{"x3", "[", "0", "]"}]}], "}"}], "==", 
                    RowBox[{"{", 
                    RowBox[{"initx1", ",", "initx2", ",", 
                    RowBox[{"1", "-", "initx1", "-", "initx2"}]}], "}"}]}]}], 
                    "}"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
                    RowBox[{"Method", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"\"\<StiffnessSwitching\>\"", ",", 
                    
                    RowBox[{"\"\<DiscontinuityProcessing\>\"", "\[Rule]", 
                    "False"}]}], "}"}]}], ",", 
                    RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], "]"}]}], 
                 "]"}]}], "\[IndentingNewLine]", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"initx1", ",", "0", ",", "1", ",", "step"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"initx2", ",", "0", ",", 
               RowBox[{"1", "-", "initx1"}], ",", "step"}], "}"}]}], "]"}], ",",
            "1"}], "]"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"We", " ", "include", " ", "Method"}], "\[Rule]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<DiscontinuityProcessing\>\"", "\[Rule]", "False"}], 
             "}"}], " ", "to", " ", "avoid", " ", 
            RowBox[{"error", ":", " ", 
             RowBox[{"NDSolve", "::", "smpf"}], ":", 
             RowBox[{
             "Failure", " ", "to", " ", "project", " ", "onto", " ", "the", " ",
               "discontinuity", " ", "surface", " ", "when", " ", "computing",
               " ", "Filippov", " ", "continuation", " ", "at", " ", "time", " ",
               "0."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"We", " ", "include", " ", "Method"}], "\[Rule]", 
            RowBox[{
             RowBox[{
              RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}], " ", "and", " ",
               "WorkingPrecision"}], "\[Rule]", 
             RowBox[{"20", " ", "to", " ", "avoid", " ", 
              RowBox[{"error", ":", " ", 
               RowBox[{"NDSolve", "::", "ndsz"}], ":", 
               
               RowBox[{"\"\<At xxx, step size is effectively zero; \
singularity or stiff system suspected.\>\"", "\[IndentingNewLine]", "See", " ", 
                RowBox[{"https", ":"}]}]}]}]}]}], "//", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/",
                "questions"}], "/", "158458"}], "/", "how"}], "-", "to", "-", 
            "evade", "-", "singularity", "-", "or", "-", "stiff", "-", 
            "system", "-", "suspected", "-", "in", "-", "ndsolve"}]}], "*)"}],
          "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "\[IndentingNewLine]", 
          RowBox[{"We", " ", 
           RowBox[{"don", "'"}], "t", " ", "move", " ", "all", " ", "this", " ",
            "to", " ", "a", " ", "function", " ", "because", " ", "we", " ", 
           "want", " ", "to", " ", "compute", " ", "the", " ", 
           "ExpectedChange", " ", "just", " ", "once"}], " ", "*)"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"##", "&"}], "[", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"listOfArrows", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tMax", "\[GreaterEqual]", "0.1"}], "&&", 
          RowBox[{"step", "\[LessEqual]", "1"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Table", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Arrowheads", "[", "0.03", "]"}], ",", 
                  RowBox[{"Arrow", "[", 
                   RowBox[{"Round", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "/.", 
                    RowBox[{"t", "\[Rule]", "i"}]}], ",", 
                    RowBox[{"#", "/.", 
                    RowBox[{"t", "\[Rule]", 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "0.1"}], ")"}]}]}]}], "}"}], ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}], "]"}], "]"}]}], "}"}], 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Round", "[", " ", 
                   RowBox[{",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}], "]"}], " ", "is", " ", "included",
                   " ", "to", " ", "avoid", " ", "drawing", " ", "arrows", " ",
                   "due", " ", "to", " ", "rounding", " ", "errors"}], "*)"}],
                 "\[IndentingNewLine]", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "0.2", ",", 
                  RowBox[{"tMax", "-", "0.1"}], ",", "3"}], "}"}]}], "]"}], 
              "&"}], ",", "listOfProjectedTrajectories"}], "]"}], 
           "\[IndentingNewLine]", ",", "1"}], "]"}], "\[IndentingNewLine]", ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"##", "&"}], "[", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"graphWithTrajectories", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tMax", ">", "0"}], "&&", 
          RowBox[{"step", "\[LessEqual]", "1"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"ParametricPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", "listOfProjectedTrajectories", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", 
           RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"##", "&"}], "[", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"background", "=", 
       RowBox[{"DensityPlot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Norm", "[", 
           RowBox[{"Simplex2DCoord", "[", 
            RowBox[{"expChange", "/.", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], "\[Rule]", 
               RowBox[{"Simplex2DInverseCoord", "[", 
                RowBox[{"{", 
                 RowBox[{"y1", ",", "y2"}], "}"}], "]"}]}], "]"}]}], "]"}], 
           "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"y1", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y2", ",", "0", ",", 
           FractionBox[
            SqrtBox["3"], "2"]}], "}"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "400"}], ",", 
         RowBox[{"ColorFunction", "\[Rule]", "colormap"}], ",", 
         RowBox[{"RegionFunction", "\[Rule]", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"y1", ",", "y2", ",", "z"}], "}"}], ",", 
            RowBox[{
             RowBox[{"y2", "<", 
              RowBox[{
               SqrtBox["3"], "y1"}]}], "&&", 
             RowBox[{"y2", "<", 
              RowBox[{
               SqrtBox["3"], 
               RowBox[{"(", 
                RowBox[{"1", "-", "y1"}], ")"}]}]}]}]}], "]"}]}], ",", 
         RowBox[{"BoundaryStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", 
         RowBox[{"Frame", "\[Rule]", "False"}], ",", 
         RowBox[{"AspectRatio", "\[Rule]", 
          FractionBox[
           SqrtBox["3"], "2"]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.1"}], ",", 
              RowBox[{"1", "+", "0.1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.1"}], ",", 
              RowBox[{
               FractionBox[
                SqrtBox["3"], "2"], "+", "0.1"}]}], "}"}], ",", "All"}], 
           "}"}]}], ",", 
         RowBox[{"Exclusions", "\[Rule]", "None"}], ",", 
         RowBox[{"PerformanceGoal", "\[Rule]", "\"\<Quality\>\""}]}], "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Exact", " ", "computations", " ", "of", " ", "rest", " ", "points"}], 
       " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rest", "=", 
       RowBox[{"TimeConstrained", "[", 
        RowBox[{
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"expChange", "\[Equal]", "0"}], ",", 
             RowBox[{"0", "\[LessEqual]", "x1", "\[LessEqual]", "1"}], ",", 
             RowBox[{"0", "\[LessEqual]", "x2", "\[LessEqual]", "1"}], ",", 
             RowBox[{"0", "\[LessEqual]", "x3", "\[LessEqual]", "1"}], ",", 
             RowBox[{
              RowBox[{"x1", "+", "x2", "+", "x3"}], "\[Equal]", "1"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}], ",", "Reals", ",", 
           RowBox[{"Backsubstitution", "->", "True"}]}], "]"}], ",", 
         "maxTimeOut"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"If", " ", "Reduce", " ", "takes", " ", "too", " ", "long"}], 
